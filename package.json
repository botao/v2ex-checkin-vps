{
  "name": "v2ex-checkin-vps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.*",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "5.3.0",
    "node-cron": "4.6.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  }
}
